# ============================================================
# SwasthiQ Clinic Front Desk Agent - Environment Configuration
# ============================================================

# Required: Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Backend server configuration
HOST=127.0.0.1
PORT=8000

# Optional: CORS allowed origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
