# ============================================================
# Backend environment variables
# Copy this file to backend/.env and fill in your values.
# Never commit the actual .env file to version control.
# ============================================================

# Required: Your Google AI Studio API key
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Comma-separated allowed frontend origins for CORS
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional: Server bind address and port
HOST=127.0.0.1
PORT=8000
